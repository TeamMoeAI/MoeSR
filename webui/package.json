{
  "name": "moesr",
  "version": "1.1.0",
  "description": "MoeSR desktop application",
  "author": "MoeSR contributors",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "cross-env MOESR_EXTERNAL_BACKEND=1 MOESR_DEBUG_WINDOWS=1 electron-vite dev",
