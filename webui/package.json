    "lint": "eslint .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win zip"
  },
  "dependencies": {
    "ws": "latest"
  },
  "devDependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@eslint/js": "^9.39.2",
    "@mui/icons-material": "latest",
    "@mui/material": "latest",
    "@vitejs/plugin-react": "^5.2.0",
    "cross-env": "^7.0.3",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^7.3.6"
  }
